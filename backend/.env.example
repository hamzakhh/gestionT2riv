# Server Configuration
NODE_ENV=production
PORT=5000

# Database
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE?options

# JWT
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARS
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=association-files

# API Configuration
API_VERSION=v1

# Frontend URL (IMPORTANT: URL de votre frontend en production)
# Cette URL sera utilisée pour la configuration CORS
# Exemples: https://votre-app.vercel.app, https://votre-app.onrender.com
FRONTEND_URL=https://votre-frontend-url.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
