{
  "name": "creative-association-backend",
  "version": "1.0.0",
  "description": "Backend API pour l'Association Creative",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "build": "cd ../frontend && npm install && npm run build",
    "build:frontend": "cd ../frontend && npm install && npm run build && cp -r dist ../backend/frontend/",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:supabase": "vitest run tests/supabase.test.js"
  },
  "keywords": [
    "association",
    "charity",
    "management"
  ],
  "author": "Association Creative",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "mongoose-paginate-v2": "^1.9.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^13.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@vitest/ui": "^5.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
