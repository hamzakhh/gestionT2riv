# Test Environment Configuration
# This file should be copied to .env.test and filled with actual test credentials

NODE_ENV=test
PORT=5001

# Test Database - USE A SEPARATE DATABASE FOR TESTING
# Example: mongodb+srv://testuser:testpassword@cluster/test-db?retryWrites=true&w=majority
MONGODB_URI_TEST=mongodb://localhost:27017/association_creative_test

# Test JWT Secret - USE A DIFFERENT SECRET FOR TESTING
JWT_SECRET_TEST=test_secret_minimum_32_characters_long_for_integration_tests
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=24h

# Test User Credentials (create this user in your test database)
TEST_USER_EMAIL=testuser@example.com
TEST_USER_PASSWORD=testpassword123
TEST_USER_FIRSTNAME=Test
TEST_USER_LASTNAME=User

# Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads_test

# Rate Limiting (relaxed for testing)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000