# Frontend Environment Variables - Example
# Ces variables sont accessibles dans le navigateur après le build
# Copiez ce fichier en .env et remplacez les valeurs

# API Backend URL (changer avec l'URL de production)
VITE_API_URL=http://localhost:5000

# Application Metadata
VITE_APP_NAME=Creative Association
VITE_APP_VERSION=1.0.0
VITE_APP_BASE_NAME=/